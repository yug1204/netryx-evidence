# NETRYX EVIDENCE — Environment Configuration
# Copy this to .env and fill in your values

# ── Application ──────────────────────────────────────────
APP_NAME=NETRYX EVIDENCE
DEBUG=true

# ── Security ─────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# ── PostgreSQL ───────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=netryx
POSTGRES_PASSWORD=netryx_secure_2025
POSTGRES_DB=netryx_evidence

# ── Neo4j ────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=netryx_graph_2025

# ── Redis ────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── MinIO / S3 ───────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=netryx_minio
MINIO_SECRET_KEY=netryx_minio_secret_2025
MINIO_BUCKET=evidence-vault

# ── AI / LLM ─────────────────────────────────────────────
OPENAI_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# ── External Intelligence APIs ───────────────────────────
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=
MISP_URL=
MISP_API_KEY=
ABUSEIPDB_API_KEY=
